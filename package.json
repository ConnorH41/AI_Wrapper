{
  "name": "ai-wrapper",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @aiw/web",
    "build": "npm run build -w @aiw/web",
    "test": "tsx --tsconfig apps/web/tsconfig.json --test tests/session.test.ts tests/motion.test.ts tests/replacement.test.ts tests/scene-review.test.ts",
    "test:browser": "playwright test",
    "test:live": "tsx scripts/live-test.ts",
    "test:motion": "tsx scripts/live-test.ts",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p tsconfig.tests.json"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "typescript": "^5.8.3"
  }
}
