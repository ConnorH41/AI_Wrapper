# Copy to .env.local in this directory. Never commit .env.local.
# Shared tester access. Use at least 16 characters for the password.
APP_ACCESS_PASSWORD=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SIGNING_SECRET=

# Required for motion generation. Read token from a free Hugging Face account.
# Keep paid billing disabled. Never put tokens in NEXT_PUBLIC_ variables.
HF_TOKEN=

# Optional: only needed to generate a character portrait from a description.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional experimental full-character preview. Disabled by default.
# Configure a provider-account spending limit and review docs/full-character-replacement.md.
# These flags are operator acknowledgements, NOT a global/durable billing cap.
FAL_KEY=
ENABLE_PAID_MOTION=false
PAID_MOTION_BUDGET_REVIEWED=false
