# Copy this file to .env.local in this directory. Never commit .env.local.
# Use free-tier accounts with paid billing disabled.
GEMINI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
GROQ_API_KEY=

# Optional character-in-a-scene motion test; not required by the still-image ad.
# Use a Read token from a free Hugging Face account. Never add it to this example.
HF_TOKEN=

# Set a shared tester password of at least 16 characters.
APP_ACCESS_PASSWORD=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SIGNING_SECRET=
